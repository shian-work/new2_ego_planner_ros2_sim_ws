<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-10.0 -10.0 8.0 0 0.35 0.785</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.5 0.25 1</ambient>
            <diffuse>0.3 0.6 0.3 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Helipad at bottom-left corner (-15, -15) -->
    <model name="spawn_helipad">
      <include>
        <uri>model://helipad</uri>
      </include>
      <pose>-15.0 -15.0 0.01 0 0 0</pose>
    </model>

    <!-- Target Helipad at top-right corner (15, 15) -->
    <model name="target_helipad">
      <include>
        <uri>model://helipad</uri>
      </include>
      <pose>15.0 15.0 0.01 0 0 0</pose>
    </model>

    <!-- Grass Patches (3x3 grid covering 40m x 40m) -->
    <model name="grasspatch_01"><include><uri>model://grasspatch</uri></include><pose>-15 15 0 0 0 0</pose></model>
    <model name="grasspatch_02"><include><uri>model://grasspatch</uri></include><pose>0 15 0 0 0 0</pose></model>
    <model name="grasspatch_03"><include><uri>model://grasspatch</uri></include><pose>15 15 0 0 0 0</pose></model>

    <model name="grasspatch_04"><include><uri>model://grasspatch</uri></include><pose>-15 0 0 0 0 0</pose></model>
    <model name="grasspatch_05"><include><uri>model://grasspatch</uri></include><pose>0 0 0 0 0 0</pose></model>
    <model name="grasspatch_06"><include><uri>model://grasspatch</uri></include><pose>15 0 0 0 0 0</pose></model>

    <model name="grasspatch_07"><include><uri>model://grasspatch</uri></include><pose>-15 -15 0 0 0 0</pose></model>
    <model name="grasspatch_08"><include><uri>model://grasspatch</uri></include><pose>0 -15 0 0 0 0</pose></model>
    <model name="grasspatch_09"><include><uri>model://grasspatch</uri></include><pose>15 -15 0 0 0 0</pose></model>

    <!-- Trees (9 Oak Trees & 9 Pine Trees evenly distributed across the 40m x 40m grass area) -->
    <model name="oak_tree_01"><include><uri>model://oak_tree</uri></include><pose>-12.0 12.0 0 0 0 0</pose></model>
    <model name="oak_tree_02"><include><uri>model://oak_tree</uri></include><pose>0.0 14.0 0 0 0 0</pose></model>
    <model name="oak_tree_03"><include><uri>model://oak_tree</uri></include><pose>18.0 12.0 0 0 0 0</pose></model>
    <model name="oak_tree_04"><include><uri>model://oak_tree</uri></include><pose>-14.0 0.0 0 0 0 0</pose></model>
    <model name="oak_tree_05"><include><uri>model://oak_tree</uri></include><pose>-2.0 2.0 0 0 0 0</pose></model>
    <model name="oak_tree_06"><include><uri>model://oak_tree</uri></include><pose>-18.0 -12.0 0 0 0 0</pose></model>
    <model name="oak_tree_07"><include><uri>model://oak_tree</uri></include><pose>0.0 -14.0 0 0 0 0</pose></model>
    <model name="oak_tree_08"><include><uri>model://oak_tree</uri></include><pose>12.0 -12.0 0 0 0 0</pose></model>
    <model name="oak_tree_09"><include><uri>model://oak_tree</uri></include><pose>-6.0 6.0 0 0 0 0</pose></model>

    <model name="pine_tree_01"><include><uri>model://pine_tree</uri></include><pose>-6.0 -6.0 0 0 0 0</pose></model>
    <model name="pine_tree_02"><include><uri>model://pine_tree</uri></include><pose>6.0 6.0 0 0 0 0</pose></model>
    <model name="pine_tree_03"><include><uri>model://pine_tree</uri></include><pose>6.0 -6.0 0 0 0 0</pose></model>
    <model name="pine_tree_04"><include><uri>model://pine_tree</uri></include><pose>-10.0 10.0 0 0 0 0</pose></model>
    <model name="pine_tree_05"><include><uri>model://pine_tree</uri></include><pose>8.0 18.0 0 0 0 0</pose></model>
    <model name="pine_tree_06"><include><uri>model://pine_tree</uri></include><pose>-10.0 -10.0 0 0 0 0</pose></model>
    <model name="pine_tree_07"><include><uri>model://pine_tree</uri></include><pose>10.0 -10.0 0 0 0 0</pose></model>
    <model name="pine_tree_08"><include><uri>model://pine_tree</uri></include><pose>-4.0 10.0 0 0 0 0</pose></model>
    <model name="pine_tree_09"><include><uri>model://pine_tree</uri></include><pose>-4.0 -10.0 0 0 0 0</pose></model>

    <!-- ========== LIGHTING ========== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- ========== ENVIRONMENT ========== -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
        
    <atmosphere type="adiabatic"/>
    
    <!-- ========== SCENE ========== -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
  
  </world>
</sdf>
